{
  "name": "@bnidev/js-utils",
  "version": "0.3.0",
  "description": "JavaScript utility functions for various tasks",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks || echo 'not in git'",
    "build": "tsdown src/index.ts --format cjs,esm --dts --out-dir dist",
    "docs:build": "typedoc --help && echo 'Note: typedoc 0.28.x does not support TypeScript 7. Upgrade when typedoc 1.x stable is released.'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "version": "changeset version",
    "postversion": "changeset-formatter"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "utility",
    "utilities",
    "helpers",
    "functions",
    "toolkit",
    "utils",
    "javascript",
    "typescript",
    "array",
    "object",
    "dom",
    "timing",
    "debounce",
    "throttle",
    "clone",
    "flatten"
  ],
  "author": "Benjamin Diener",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnidev/js-utils.git"
  },
  "homepage": "https://bnidev.github.io/js-utils",
  "bugs": {
    "url": "https://github.com/bnidev/js-utils/issues"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^5.0.0",
    "changeset-formatter": "^0.0.1",
    "glob": "^13.0.0",
    "happy-dom": "^20.9.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
