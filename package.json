{
  "name": "@bnidev/js-utils",
  "version": "0.3.0",
  "description": "JavaScript utility functions for various tasks",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks || echo 'not in git'",
    "build": "tsdown src/index.ts --format cjs,esm --dts --out-dir dist",
    "docs:build": "bash -c 'cp tsconfig.json tsconfig.json.ts7 && cp tsconfig.typedoc.json tsconfig.json && pnpm add -D typescript@6 && pnpm exec typedoc --plugin typedoc-github-theme && pnpm add -D typescript@7 && mv tsconfig.json tsconfig.typedoc.json && mv tsconfig.json.ts7 tsconfig.json'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "version": "changeset version",
    "postversion": "changeset-formatter"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "utility",
    "utilities",
    "helpers",
    "functions",
    "toolkit",
    "utils",
    "javascript",
    "typescript",
    "array",
    "object",
    "dom",
    "timing",
    "debounce",
    "throttle",
    "clone",
    "flatten"
  ],
  "author": "Benjamin Diener",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnidev/js-utils.git"
  },
  "homepage": "https://bnidev.github.io/js-utils",
  "bugs": {
    "url": "https://github.com/bnidev/js-utils/issues"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^5.0.0",
    "changeset-formatter": "^1.0.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.0",
    "happy-dom": "^20.9.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
